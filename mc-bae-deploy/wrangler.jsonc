{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-site-3",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-14",
  "vars": {
    "ADMIN_APP_TOKEN_SHA256": "847d2650f7e44fa8313f89597fc8ac54903a5ecbb5d8f1c58c49c6121128e364",
    "ADMIN_PASSWORD_SHA256": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STORAGE",
        "class_name": "McBaeStorage"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McBaeStorage"]
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
