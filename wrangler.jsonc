{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-site",
  "main": "worker-admin-app.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "vars": {
    "ADMIN_PASSWORD_SHA256": "c87d431851bb55cddb601e9bd8bd7eadd7bc0f4906e41318e17d63379a23b483",
    "ROBOT_WEBHOOK_TOKEN_SHA256": "af7b8a170b3bdd6a0cc655d9133e4d648c3ae8d636063ec4c11aa0cdc200026a",
    "ROBOT_SERVICE_URL": "https://lanchonete-whatsapp-robot-production.up.railway.app/instances/lanchonete-whatsapp",
    "FCM_PROJECT_ID": "lanchonete-admin",
    "FCM_ANDROID_API_KEY": "AIzaSyBxBWHnh0y5sExe81CIoQ6cV6czDFIHDGs",
    "FCM_ANDROID_APP_ID": "1:35803389315:android:2d8d6884073057cb05aab6",
    "FCM_SENDER_ID": "35803389315"
  },
  "kv_namespaces": [
    {
      "binding": "PROMOTIONS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_STORAGE",
        "class_name": "AppStorage"
      }
    ]
  },
  "exports": {
    "AppStorage": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
