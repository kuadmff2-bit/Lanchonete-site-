{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lanchonete-site",
  "main": "worker.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "secrets": {
    "required": ["ADMIN_PASSWORD"]
  },
  "kv_namespaces": [
    {
      "binding": "PROMOTIONS"
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
