<resources>
    <style name="Theme.LanchoneteAdmin" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#0D0D0D</item>
        <item name="android:statusBarColor">#0D0D0D</item>
        <item name="android:navigationBarColor">#0D0D0D</item>
        <item name="android:colorAccent">#F58213</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Android 12+: o splash do sistema fica neutro e some rápido; a SplashView nativa mostra o hambúrguer. -->
        <item name="android:windowSplashScreenBackground">#0D0D0D</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#0D0D0D</item>
        <item name="android:windowSplashScreenAnimationDuration">50</item>
    </style>
</resources>
